# ── Backend configuration ─────────────────────────────────────────────────────
# SQLAlchemy connection URL using the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to print every SQL statement SQLAlchemy executes.
SQL_ECHO=false

# ── Database used only by the automated test suite ────────────────────────────
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_test

# ── Frontend (optional, put in frontend/.env) ────────────────────────────────
# VITE_API_URL=http://localhost:8000/api
